{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenToSkill",
  "version": "0.1.0",
  "identifier": "io.github.screentoskill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ScreenToSkill", "width": 920, "height": 680, "minWidth": 720, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "MIT License",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/whisper-cli", "binaries/ocr-helper"],
    "resources": {
      "../engine/video_to_index.py": "engine/video_to_index.py",
      "../templates/skill_prompt.md": "templates/skill_prompt.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
